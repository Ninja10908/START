local SAFE_ZONE_CENTER=Vector3.new(-410.53,-6.47,59.37)
local SAFE_ZONE_SIZE=Vector3.new(140,1,400)
local function okay(position)
local xDiff=math.abs(position.X - SAFE_ZONE_CENTER.X)
local zDiff=math.abs(position.Z - SAFE_ZONE_CENTER.Z)
return xDiff <=SAFE_ZONE_SIZE.X / 2 and zDiff <=SAFE_ZONE_SIZE.Z / 2
end
local function parseValue(text)
text=tostring(text or ""):gsub("%s","")
local num,suffix=text:match("([%d%.]+)([KkMmBbTt]?)")
if not num then return 0 end
num=tonumber(num) or 0
local multipliers={
K=1e3,M=1e6,B=1e9,T=1e12
}
return num * (multipliers[(suffix or ""):upper()] or 1)
end
local function scanAllPetsFromESP()
