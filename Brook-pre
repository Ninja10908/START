local function moveStep(targetPos)
local char=LocalPlayer.Character
local hrp=char and char:FindFirstChild("HumanoidRootPart")
if not hrp then
return false
end
local SPEED=300
local STOP_DISTANCE=5
while (hrp.Position - targetPos).Magnitude > STOP_DISTANCE do
if cancelTp then
hrp.Velocity=Vector3.zero
return false
end
local direction=targetPos - hrp.Position
if direction.Magnitude <=STOP_DISTANCE then
break
end
hrp.Velocity=direction.Unit * SPEED
RunService.Heartbeat:Wait()
end
hrp.Velocity=Vector3.zero
return true
end
