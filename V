local function parse(t)
t=tostring(t or ""):gsub("%s","")
local n,s=t:match("([%d%.]+)([KkMmBbTt]?)")
if not n then return 0 end
n=tonumber(n) or 0
local m={K=1e3,M=1e6,B=1e9,T=1e12}
return n * (m[(s or ""):upper()] or 1)
end
